# Backend Settings
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./sentinel_twin.db

# Gemma 4 Provider Configuration
# Modes: "ollama" | "google_genai" | "openai_compatible" | "deterministic_fallback"
GEMMA_PROVIDER=deterministic_fallback
GEMMA_MODEL_NAME=gemma4:latest
GEMMA_API_BASE=http://localhost:11434
GEMMA_API_KEY=

# Sandbox Execution Settings
DOCKER_SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=45

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1